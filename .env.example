# Copy this file to .env and fill in real values. Never commit .env itself.

# --- App ---
PROJECT_NAME=TalentSync
API_V1_PREFIX=/api/v1
ENVIRONMENT=local
DEBUG=true

# --- Database ---
# Local (Docker Compose):
DATABASE_URL=postgresql+psycopg://talentsync:talentsync@localhost:5432/talentsync
# Hosted demo (Neon/Supabase) — swap in the connection string they give you, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Auth / JWT ---
# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-secret-before-any-hosted-demo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
